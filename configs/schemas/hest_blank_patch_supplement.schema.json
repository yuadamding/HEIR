{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HEIR receipt-bound HEST blank-patch supplement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "scope", "control_id", "protocol_sha256",
    "registered_source_sha256", "registered_source_bytes",
    "ordered_observation_ids_sha256", "source_rows", "source_members_opened",
    "source_bytes_hashed_without_deserialization", "encoder_repository",
    "encoder_revision", "encoder_manifest_sha256", "config_sha256",
    "checkpoint_sha256", "input_shape", "input_dtype", "input_layout",
    "input_rgb_value", "input_sha256", "feature_shape", "feature_dtype",
    "feature_sha256", "broadcast_rows", "broadcast_rule", "supplement_schema",
    "supplement_sha256", "supplement_members", "batch_parity", "implementation",
    "runtime", "molecular_outcomes_read", "predictions_read",
    "biological_experiment_run"
  ],
  "properties": {
    "schema": {"const": "heir.hest_blank_patch_supplement.v1"},
    "status": {"const": "passed"},
    "scope": {"const": "outcome_blind_blank_image_control_only"},
    "control_id": {"const": "blank_white_negative_control"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "registered_source_sha256": {"$ref": "#/$defs/sha256"},
    "registered_source_bytes": {"type": "integer", "minimum": 1},
    "ordered_observation_ids_sha256": {"$ref": "#/$defs/sha256"},
    "source_rows": {"const": 36121},
    "source_members_opened": {"const": ["observation_ids"]},
    "source_bytes_hashed_without_deserialization": {"const": true},
    "encoder_repository": {"const": "bioptimus/H-optimus-1"},
    "encoder_revision": {"const": "3592cb220dec7a150c5d7813fb56e68bd57473b9"},
    "encoder_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "input_shape": {"const": [1, 224, 224, 3]},
    "input_dtype": {"const": "uint8"},
    "input_layout": {"const": "NHWC_RGB"},
    "input_rgb_value": {"const": [255, 255, 255]},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "feature_shape": {"const": [1, 1536]},
    "feature_dtype": {"const": "float32"},
    "feature_sha256": {"$ref": "#/$defs/sha256"},
    "broadcast_rows": {"const": 36121},
    "broadcast_rule": {"const": "repeat_identical_feature_for_each_observation"},
    "supplement_schema": {"const": "heir.hest_blank_patch_supplement_npz.v1"},
    "supplement_sha256": {"$ref": "#/$defs/sha256"},
    "supplement_members": {
      "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "batch_parity": {
      "type": "object", "additionalProperties": false,
      "required": [
        "batch_sizes", "batch_1_feature_sha256", "batch_32_features_sha256",
        "minimum_cosine", "mean_cosine", "maximum_absolute_error",
        "minimum_required_cosine", "all_finite", "all_nonzero", "passed"
      ],
      "properties": {
        "batch_sizes": {"const": [1, 32]},
        "batch_1_feature_sha256": {"$ref": "#/$defs/sha256"},
        "batch_32_features_sha256": {"$ref": "#/$defs/sha256"},
        "minimum_cosine": {"type": "number", "minimum": 0.9999, "maximum": 1.000001},
        "mean_cosine": {"type": "number", "minimum": 0.9999, "maximum": 1.000001},
        "maximum_absolute_error": {"type": "number", "minimum": 0},
        "minimum_required_cosine": {"const": 0.9999},
        "all_finite": {"const": true},
        "all_nonzero": {"const": true},
        "passed": {"const": true}
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "builder_sha256", "receipt_validator_sha256", "encoder_adapter_sha256",
        "encoder_base_sha256"
      ],
      "properties": {
        "builder_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_validator_sha256": {"$ref": "#/$defs/sha256"},
        "encoder_adapter_sha256": {"$ref": "#/$defs/sha256"},
        "encoder_base_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": [
        "git_commit", "git_worktree_dirty_at_start", "python_version", "numpy_version",
        "torch_version", "timm_version", "safetensors_version", "device",
        "cuda_device_name", "cuda_autocast_enabled_by_encoder", "tf32_enabled",
        "cublas_workspace_config"
      ],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_worktree_dirty_at_start": {"const": false},
        "python_version": {"type": "string", "minLength": 1},
        "numpy_version": {"type": "string", "minLength": 1},
        "torch_version": {"type": "string", "minLength": 1},
        "timm_version": {"type": "string", "minLength": 1},
        "safetensors_version": {"type": "string", "minLength": 1},
        "device": {"enum": ["cpu", "cuda", "cuda:0"]},
        "cuda_device_name": {"type": ["string", "null"]},
        "cuda_autocast_enabled_by_encoder": {"type": "boolean"},
        "tf32_enabled": {"const": false},
        "cublas_workspace_config": {"enum": [":4096:8", ":16:8"]}
      }
    },
    "molecular_outcomes_read": {"const": false},
    "predictions_read": {"const": false},
    "biological_experiment_run": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
